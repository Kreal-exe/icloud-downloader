<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:iCloudDownloader.Controls"
        xmlns:l="clr-namespace:iCloudDownloader"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="iCloudDownloader.MainWindow"
        Title="iCloud Downloader" Width="1120" Height="740" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="avares://iCloudDownloader/Assets/icon.png"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Body}">

    <Window.Styles>
        <Style Selector="Border.stat">
            <Setter Property="Background" Value="{DynamicResource Brush.Inset}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.statLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style Selector="TextBlock.logError"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" /></Style>
        <Style Selector="TextBlock.logWarning"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></Style>
        <Style Selector="TextBlock.logOk"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></Style>
        <Style Selector="TextBlock.logFile"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" /></Style>
        <Style Selector="Border.dialog">
            <Setter Property="Background" Value="{DynamicResource Brush.Popup}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="28,24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BoxShadow" Value="0 16 56 0 #66000000" />
        </Style>
    </Window.Styles>

    <Grid ClipToBounds="True">
        <!-- ambient background, as in JuiceDownloader -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="820" Height="820" Fill="{DynamicResource Brush.Blob1}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-360,0,0" />
            <Ellipse Width="720" Height="720" Fill="{DynamicResource Brush.Blob2}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-300,-220,0" />
            <Ellipse Width="640" Height="640" Fill="{DynamicResource Brush.Blob3}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,120,-400" />
        </Grid>

        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,16,24,20">

            <!-- header: app, account, settings -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="avares://iCloudDownloader/Assets/icon.png" Width="34" Height="34" />
                    <TextBlock Text="iCloud Downloader" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- signed in -->
                    <Border x:Name="AccountChip" Classes="card" Padding="6,5,6,5" CornerRadius="999" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Brush.AccentGradient}">
                                <TextBlock x:Name="AvatarText" Text="?" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AccountName" FontSize="13" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AccountState" Text="{l:T account.connected}" Classes="caption" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="SignOutButton" Classes="subtle" Content="{l:T account.signOut}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- not signed in -->
                    <Button x:Name="SignInButton" Classes="ghost" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="AppleIcloud" Width="18" Height="18" />
                            <TextBlock Text="{l:T account.signIn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenFolderButton" Classes="icon" ToolTip.Tip="{l:T header.openFolder}">
                        <mi:MaterialIcon Kind="FolderOpenOutline" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="ThemeButton" Classes="icon" ToolTip.Tip="{l:T header.theme}">
                        <mi:MaterialIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="SettingsButton" Classes="icon" ToolTip.Tip="{l:T header.settings}">
                        <mi:MaterialIcon Kind="CogOutline" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- where, how fast, go -->
            <Border Grid.Row="1" Classes="card" Padding="20,16" Margin="0,0,0,14">
                <Grid ColumnDefinitions="*,16,Auto,16,Auto">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{l:T main.folder}" />
                        <Grid ColumnDefinitions="*,8,Auto">
                            <TextBox x:Name="FolderBox" />
                            <Button x:Name="BrowseButton" Grid.Column="2" Classes="ghost" Padding="12,8">
                                <mi:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="{l:T main.threads}" />
                        <NumericUpDown x:Name="WorkersBox" Minimum="1" Maximum="16" Increment="1" FormatString="0" Width="124" CornerRadius="10"
                                       ToolTip.Tip="{l:T main.threadsTip}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                        <Button x:Name="StartButton" Classes="primary" Padding="22,11">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="CloudDownloadOutline" Width="18" Height="18" />
                                <TextBlock Text="{l:T main.start}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Classes="danger" Padding="18,11" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Stop" Width="18" Height="18" />
                                <TextBlock Text="{l:T main.stop}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- progress -->
            <Border Grid.Row="2" Classes="card" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="tile" Background="{DynamicResource Brush.AccentSoft}">
                            <mi:MaterialIcon x:Name="StageIcon" Kind="CloudOutline" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusDetail" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="PercentText" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock x:Name="EtaText" Classes="muted" FontSize="12.5" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <c:SmoothBar x:Name="Bar" Height="10" Margin="0,16,0,16" Fill="{DynamicResource Brush.AccentGradient}" Track="{DynamicResource Brush.Track}" />

                    <Grid ColumnDefinitions="*,*,*,*,*,*">
                        <Border Classes="stat"><StackPanel><TextBlock x:Name="TotalText" Classes="statValue" Text="—" /><TextBlock Classes="statLabel" Text="{l:T stat.total}" /></StackPanel></Border>
                        <Border Grid.Column="1" Classes="stat"><StackPanel><TextBlock x:Name="ExistedText" Classes="statValue" Text="—" /><TextBlock Classes="statLabel" Text="{l:T stat.existed}" /></StackPanel></Border>
                        <Border Grid.Column="2" Classes="stat"><StackPanel><TextBlock x:Name="DownloadedText" Classes="statValue" Foreground="{DynamicResource Brush.Success}" Text="—" /><TextBlock Classes="statLabel" Text="{l:T stat.downloaded}" /></StackPanel></Border>
                        <Border Grid.Column="3" Classes="stat"><StackPanel><TextBlock x:Name="LeftText" Classes="statValue" Text="—" /><TextBlock Classes="statLabel" Text="{l:T stat.left}" /></StackPanel></Border>
                        <Border Grid.Column="4" Classes="stat"><StackPanel><TextBlock x:Name="FailedText" Classes="statValue" Text="—" /><TextBlock Classes="statLabel" Text="{l:T stat.failed}" /></StackPanel></Border>
                        <Border Grid.Column="5" Classes="stat" Margin="0"><StackPanel><TextBlock x:Name="SpeedText" Classes="statValue" Text="—" /><TextBlock x:Name="BytesText" Classes="statLabel" /></StackPanel></Border>
                    </Grid>

                    <!-- a problem, said plainly -->
                    <Border x:Name="ProblemBox" IsVisible="False" Margin="0,14,0,0" CornerRadius="12" Padding="14,12" Background="{DynamicResource Brush.DangerSoft}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <mi:MaterialIcon Kind="AlertCircleOutline" Width="22" Height="22" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <TextBlock x:Name="ProblemText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ProblemDetail" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="80" />
                            </StackPanel>
                            <Button x:Name="RetryButton" Grid.Column="2" Classes="ghost" Content="{l:T problem.retry}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- now downloading | log -->
            <Grid Grid.Row="3" ColumnDefinitions="*,14,1.25*">
                <Border Classes="card" Padding="18,14">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <mi:MaterialIcon Kind="ProgressDownload" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{l:T active.title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <!-- right margin: the overlay scroll bar must not cover the sizes -->
                            <ItemsControl x:Name="ActiveList" Margin="0,0,16,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Info}" Classes="caption" Margin="8,0,0,0" />
                                            </Grid>
                                            <c:SmoothBar Height="5" Margin="0,5,0,0" Value="{Binding Fraction}" Fill="{DynamicResource Brush.Accent}" Track="{DynamicResource Brush.Track}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="ActiveEmpty" Grid.Row="1" Classes="caption" Text="{l:T active.empty}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="card" Padding="18,14">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,10">
                            <mi:MaterialIcon Kind="TextBoxOutline" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Grid.Column="1" Text="{l:T log.title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <CheckBox x:Name="ErrorsOnlyBox" Grid.Column="2" Content="{l:T log.errorsOnly}" FontSize="12" Margin="0,0,10,0" />
                            <Button x:Name="CopyLogButton" Grid.Column="3" Classes="subtle" Content="{l:T log.copy}" />
                        </Grid>
                        <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4,3,18,3" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Detail}">
                                        <TextBlock Text="{Binding Time}" Classes="caption" Margin="0,1,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap"
                                                   Classes.logError="{Binding LevelError}" Classes.logWarning="{Binding LevelWarning}"
                                                   Classes.logOk="{Binding LevelOk}" Classes.logFile="{Binding LevelFile}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- sign in -->
        <Grid x:Name="LoginOverlay" IsVisible="False" Background="{DynamicResource Brush.Overlay}">
            <Border Classes="dialog" Width="460">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="tile" Background="{DynamicResource Brush.AccentSoft}">
                            <mi:MaterialIcon x:Name="LoginIcon" Kind="AppleIcloud" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <TextBlock x:Name="LoginTitle" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- step 1: Apple ID and password -->
                    <StackPanel x:Name="CredentialsStep" Spacing="12">
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T login.hint}" />
                        <StackPanel>
                            <TextBlock Classes="label" Text="{l:T login.appleId}" />
                            <TextBox x:Name="LoginUserBox" Watermark="name@icloud.com" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="label" Text="{l:T login.password}" />
                            <TextBox x:Name="PasswordBox" PasswordChar="●" RevealPassword="False" Watermark="{l:T login.passwordWatermark}" />
                        </StackPanel>
                        <CheckBox x:Name="RememberBox" Content="{l:T login.remember}" IsChecked="True" FontSize="12.5" />
                    </StackPanel>

                    <!-- step 2: the code -->
                    <StackPanel x:Name="CodeStep" Spacing="12" IsVisible="False">
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T code.hint}" />
                        <TextBox x:Name="CodeBox" Watermark="••••••" MaxLength="6" FontSize="28" FontWeight="SemiBold" HorizontalContentAlignment="Center" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T code.noCode}" />
                    </StackPanel>

                    <Border x:Name="LoginErrorBox" IsVisible="False" CornerRadius="10" Padding="12,10" Background="{DynamicResource Brush.DangerSoft}">
                        <TextBlock x:Name="LoginError" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,10,Auto" Margin="0,4,0,0">
                        <TextBlock x:Name="LoginBusy" Classes="muted" VerticalAlignment="Center" Text="{l:T busy.checking}" IsVisible="False" />
                        <Button x:Name="LoginCancel" Grid.Column="1" Classes="ghost" Content="{l:T login.cancel}" />
                        <Button x:Name="LoginOk" Grid.Column="3" Classes="primary" Padding="22,10" IsDefault="True">
                            <TextBlock x:Name="LoginOkText" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- settings -->
        <Grid x:Name="SettingsOverlay" IsVisible="False" Background="{DynamicResource Brush.Overlay}">
            <Border Classes="dialog" Width="520">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="tile" Background="{DynamicResource Brush.AccentSoft}">
                            <mi:MaterialIcon Kind="CogOutline" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <TextBlock Text="{l:T settings.title}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{l:T settings.language}" />
                            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" CornerRadius="10">
                                <ComboBoxItem Content="Русский" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="{l:T settings.theme}" />
                            <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" CornerRadius="10">
                                <ComboBoxItem Content="{l:T theme.system}" />
                                <ComboBoxItem Content="{l:T theme.light}" />
                                <ComboBoxItem Content="{l:T theme.dark}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="AutoRestartBox" Content="{l:T settings.autoRestart}" />
                    <CheckBox x:Name="KeepAwakeBox" Content="{l:T settings.keepAwake}" />
                    <StackPanel>
                        <CheckBox x:Name="HiddenBox" Content="{l:T settings.hidden}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Margin="32,2,0,0" Text="{l:T settings.hiddenHint}" />
                    </StackPanel>
                    <StackPanel>
                        <CheckBox x:Name="VideosByNameBox" Content="{l:T settings.videosByName}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Margin="32,2,0,0" Text="{l:T settings.videosByNameHint}" />
                    </StackPanel>
                    <Border CornerRadius="12" Padding="14,12" Background="{DynamicResource Brush.Inset}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{l:T settings.threadsTitle}" FontWeight="SemiBold" />
                            <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{l:T settings.threadsText}" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="LogsButton" Classes="ghost" Content="{l:T settings.logs}" />
                        <TextBlock x:Name="VersionText" Grid.Column="1" Classes="caption" VerticalAlignment="Center" Margin="12,0" />
                        <Button x:Name="SettingsClose" Grid.Column="2" Classes="primary" Padding="22,10" Content="{l:T settings.close}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
